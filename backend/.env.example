DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5000/subsplit_db?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5001
APP_URL="http://localhost:5173"

# Recommended for Render Free: Resend uses HTTPS rather than blocked SMTP ports.
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="SubSplit <onboarding@resend.dev>"

# Optional local fallback: SMTP is blocked on Render Free services.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-address@gmail.com"
SMTP_PASS="your-16-character-Google-App-Password"
SMTP_FROM="SubSplit <your-address@gmail.com>"
